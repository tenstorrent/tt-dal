#
## CMake
#

# Build directory
/build/

# CMake
compile_commands.json

# Language server cache (clangd)
.cache/

#
## Cargo
#

# Generated by Cargo
# will have compiled files and executables
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

#
## UV
#

# Similar to Pipfile.lock, it is generally recommended to include uv.lock in
# version control. This is especially recommended for binary packages to ensure
# reproducibility, and is more commonly ignored for libraries.
uv.lock
